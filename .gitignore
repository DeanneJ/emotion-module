# ============================================================
# Root .gitignore - Emotion Module Workspace
# ============================================================

# -------------------- OS Files --------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~

# -------------------- IDE / Editor --------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg
build/
dist/
wheels/
*.whl
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# -------------------- Node.js --------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.parcel-cache/

# -------------------- ML Model Files --------------------
# (Large binary files - use Git LFS or download scripts instead)
*.pth
*.pt
*.bin
*.safetensors
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.tflite
*.pb
*.ckpt
*.ckpt.*

# -------------------- Environment / Secrets --------------------
.env
.env.local
.env.*.local
!.env.example

# -------------------- Logs --------------------
logs/
*.log

# -------------------- Docker --------------------
docker-compose.override.yml

# ============================================================
# Project-Specific: emo-app
# ============================================================

# Datasets (large, downloadable separately)
emo-app/data/fer2013/
emo-app/data/goemotions/

# Sarcasm + Slang datasets and results
emo-app/sarcasm + slang/data/sarcasm/
emo-app/sarcasm + slang/data/slang/
emo-app/sarcasm + slang/downloaded datasets/
emo-app/sarcasm + slang/results/

# ============================================================
# Project-Specific: affectnet-app
# ============================================================

# Model checkpoints (large ~32MB+ each)
affectnet-app/models/affectnet/*.pth

# ============================================================
# Project-Specific: opensource-socialnetwork (OSSN)
# ============================================================

# OSSN config files with DB credentials
opensource-socialnetwork/configurations/ossn.config.db.php
opensource-socialnetwork/configurations/ossn.config.site.php
.user.ini  
#sayuni added .user.ini  

# OSSN generated cache
opensource-socialnetwork/cache/

# OSSN installation lock file
opensource-socialnetwork/installation/INSTALLED

# OSSN htaccess and user.ini (generated by installer)
opensource-socialnetwork/.htaccess
opensource-socialnetwork/.user.ini

# OSSN data directory (if stored locally)
ossn_data/

# models/ directory if it contains large model files
model/
models/


#sayuni added
#do not include following files
/components/*
/cache
/installation/INSTALLED
/.htaccess
Thumbs.db
Desktop.ini
DISPLAY_ERRORS
error_log

#do not ignore config files
!/.scrutinizer.yml
!/.travis.yml

